# SMARTAGENT runtime & data (never commit)
# .refrepos = cloned reference repos (read-only, large, embedded git repos)
.refrepos/
# .pi = vendored pi runtime, sessions, agent config + router key/auth.
# Everything ignored EXCEPT the pinned runtime manifest (package.json + bun.lock),
# which release CI needs to build bundles. node_modules, agent/ (keys/settings),
# and sessions/ stay ignored.
.pi/*
!.pi/runtime/
.pi/runtime/*
!.pi/runtime/package.json
!.pi/runtime/bun.lock
# agent CLI state/history (local only)
.agents/
.claude/
.codex/
# data = durable stores: semdb tables, secrets, schedule journal
data/
# workspaces = subagent runs + sandbox scratch
workspaces/
# throwaway probes / test dbs
.scratch/

# Secrets (defense in depth — must never be tracked)
*.key
*.pem
*.env
.env
.env.*
secrets.key
*credentials*
config/*.local.conf
# local mail config (himalaya) — user-specific; password fetched via secrets bridge
config/himalaya*.toml

# Release bundles (built by scripts/package.sh + CI; uploaded to GH Releases)
dist/

# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Node / bun (extension runtime)
node_modules/
bun.lockb

# Logs & temp
*.log
*.tmp
*.bak

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
.smartagent/

# Task worktrees
worktrees/
