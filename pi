#!/bin/sh
# Project-scoped pi launcher for SMARTAGENT.
# - Config/extensions/sessions live under this repo (.pi/), not ~/.pi
# - Auto-loads every pi extension in extensions/*.ts
# - Pins the real pi binary; the PATH `pi` is never consulted

ROOT="$(cd "$(dirname "$0")" && pwd)"
PI_BIN="${SMARTAGENT_PI_BIN:-$ROOT/.pi/runtime/node_modules/.bin/pi}"

if [ ! -x "$PI_BIN" ]; then
    echo "error: vendored pi not found at $PI_BIN" >&2
    echo "bootstrap: cd .pi/runtime && bun add @earendil-works/pi-coding-agent" >&2
    exit 1
fi

export PI_CODING_AGENT_DIR="$ROOT/.pi/agent"
export PI_CODING_AGENT_SESSION_DIR="$ROOT/.pi/sessions"
mkdir -p "$PI_CODING_AGENT_DIR" "$PI_CODING_AGENT_SESSION_DIR"

# ── Self-update (EXPLICIT only: `./pi --self-update`) ──────────────────────
# Normal launches never touch the network or mutate the pinned runtime — the
# old unpinned daily `bun update` silently jumped versions and blocked startup
# when offline. Update is now opt-in, verified with a smoke test, and rolls
# back on failure. The exact version lives in .pi/runtime/package.json (pinned).
if [ "$1" = "--self-update" ]; then
    cd "$ROOT/.pi/runtime" || exit 1
    cp package.json package.json.bak 2>/dev/null
    cp bun.lock bun.lock.bak 2>/dev/null
    OLD_VER="$("$PI_BIN" --version 2>/dev/null)"
    printf 'pi self-update: fetching latest…\n'
    if ! bun update @earendil-works/pi-coding-agent >"$ROOT/.pi/update.log" 2>&1; then
        echo "self-update: bun update failed (see .pi/update.log); keeping $OLD_VER" >&2
        mv package.json.bak package.json 2>/dev/null; mv bun.lock.bak bun.lock 2>/dev/null
        exit 1
    fi
    NEW_VER="$("$PI_BIN" --version 2>/dev/null)"
    printf 'pi self-update: smoke-testing %s…\n' "$NEW_VER"
    if printf '' | "$PI_BIN" -p 'reply with the single word OK' </dev/null >/dev/null 2>&1; then
        rm -f package.json.bak bun.lock.bak
        echo "self-update: $OLD_VER → $NEW_VER ✔"
    else
        echo "self-update: smoke test FAILED on $NEW_VER — rolling back to $OLD_VER" >&2
        mv package.json.bak package.json 2>/dev/null; mv bun.lock.bak bun.lock 2>/dev/null
        bun install >>"$ROOT/.pi/update.log" 2>&1
        exit 1
    fi
    exit 0
fi

# Load project extensions (thin glue over crates/ binaries).
set --  "$@"
for ext in "$ROOT"/extensions/*.ts; do
    [ -e "$ext" ] && set -- -e "$ext" "$@"
done

# Project isolation: disable pi's AGENTS.md ancestor walk (it would pull in
# ~/AGENTS.md). Inject explicitly: the repo's AGENTS.md, plus the invocation
# cwd's AGENTS.md when launched from elsewhere.
INVOKE_CWD="$(pwd)"
set -- --no-context-files "$@"
if [ -f "$ROOT/AGENTS.md" ]; then
    set -- --append-system-prompt "$ROOT/AGENTS.md" "$@"
fi
if [ "$INVOKE_CWD" != "$ROOT" ] && [ -f "$INVOKE_CWD/AGENTS.md" ]; then
    set -- --append-system-prompt "$INVOKE_CWD/AGENTS.md" "$@"
fi

# Inject the tools brief into the agent's initial context so it never has to
# guess what capabilities exist. Kept current alongside the extensions catalog.
TOOLS_BRIEF="$ROOT/AGENT_TOOLS.md"
if [ -f "$TOOLS_BRIEF" ]; then
    set -- --append-system-prompt "$TOOLS_BRIEF" "$@"
fi

# Session memory: inject the most-recent episodic memories (past session
# intents, stored on shutdown by the session-memory extension) so the agent
# picks up with continuity instead of amnesia. Safe: pure context append.
MEM_BIN="$ROOT/target/release/memory"
if [ -x "$MEM_BIN" ] && [ -d "$ROOT/data/memory" ]; then
    RECENT="$("$MEM_BIN" recent --dir "$ROOT/data/memory" --tier episodic --n 5 2>/dev/null)"
    if [ -n "$RECENT" ] && [ "$RECENT" != "no memories" ]; then
        set -- --append-system-prompt "Recent context from past sessions (episodic memory):
$RECENT" "$@"
    fi
fi

# Run in the invocation cwd (agent dir/sessions/extension bins are absolute).
cd "$INVOKE_CWD"
exec "$PI_BIN" "$@"
