[Unit]
# Headless Chrome with a CDP endpoint on :9222 for the `browser` tool.
# Without this, `browser` fails at call time after every reboot.
Description=SMARTAGENT headless Chromium (CDP :9222)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/chromium --headless=new --remote-debugging-port=9222 \
    --user-data-dir=%h/Projects/SMARTAGENT/.pi/chrome-profile \
    --no-first-run --no-default-browser-check --disable-gpu
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
